# Phase 1 local settings. scripts/configure_local.py creates an ignored private .env.
APP_ENV=development
APP_ORIGIN=http://localhost:5173
API_PORT=8000
FRONTEND_PORT=5173
POSTGRES_DB=pathable
POSTGRES_USER=pathable_owner
# Set a locally generated password securely; never commit the populated file.
POSTGRES_PASSWORD=
# Restricted application role; owner credentials are used only for migrations/bootstrap.
APP_DB_USER=pathable_app
APP_DB_PASSWORD=
# Separate random key for hashing rate-limit identifiers (Phase 1).
RATE_LIMIT_HASH_KEY=
# Separate random secret for session-bound CSRF tokens (Phase 1).
CSRF_SECRET=
# API and migrations construct separate URLs; host is localhost for native API.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SESSION_COOKIE_SECURE=false
UPLOAD_ROOT=.local/uploads
# Optional ML remains disabled without approved held-out evaluated assets.
ML_ENABLED=false
ML_ASSET_ROOT=.local/ml-models
# ML_PYTHON defaults to this checkout's .local/ml-venv/bin/python.
# When overriding it, use an absolute executable path.
ML_WORKER_DB_USER=pathable_ml_worker
# ML_WORKER_DB_PASSWORD is generated privately by scripts/configure_ml.py;
# supply at least 24 random characters when configuring it yourself.
# Optional external basemap; blank means geometry-only map with no tile requests.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
