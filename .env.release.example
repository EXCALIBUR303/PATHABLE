# Copy to a private 0600 file; enter real credentials and a trusted TLS certificate.
# The localhost test generator is scripts/configure_release.py --local-test.
RELEASE_PROJECT=pathable-release
RELEASE_UID=10001
RELEASE_GID=10001
# Keep loopback until an operator explicitly authorizes network deployment.
RELEASE_BIND=127.0.0.1
RELEASE_HTTPS_PORT=8443
APP_ORIGIN=https://localhost:8443
POSTGRES_DB=pathable
POSTGRES_USER=pathable_owner
POSTGRES_PASSWORD=
APP_DB_USER=pathable_app
APP_DB_PASSWORD=
CSRF_SECRET=
RATE_LIMIT_HASH_KEY=
ML_WORKER_DB_USER=pathable_ml_worker
# Absolute host directories readable/writable by the configured non-root UID.
RELEASE_UPLOAD_ROOT=
RELEASE_MODEL_ROOT=
RELEASE_TLS_ROOT=
# Leave blank for the system's public CA store; set only for an explicit private CA.
RELEASE_CA_FILE=
# Optional reviewed image tags/digests, produced by the build workflow.
RELEASE_API_IMAGE=pathable-api:local
RELEASE_WEB_IMAGE=pathable-web:local
